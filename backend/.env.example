NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://dms:dms@localhost:5432/dms?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# S3 / MinIO (local dev uses MinIO via docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dms-documents
S3_ACCESS_KEY_ID=dms-minio
S3_SECRET_ACCESS_KEY=dms-minio-secret
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_UPLOAD_TTL_SECONDS=300
S3_PRESIGN_DOWNLOAD_TTL_SECONDS=300
